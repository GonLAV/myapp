# QA Copilot Environment Configuration

# ------------------------------------------------------------------
# LLM / AI Settings
# ------------------------------------------------------------------
# OpenAI API key (optional). Without it, scenario generation falls back to a
# deterministic heuristic and bug classification uses default values.
# You may also point this at any OpenAI-compatible endpoint
# (e.g. Azure OpenAI, Ollama, LM Studio) by setting OPENAI_BASE_URL.
OPENAI_API_KEY=sk-...

# Optional: override the default OpenAI base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for test-scenario generation & bug analysis
OPENAI_MODEL=gpt-4o-mini

# Dynamic discovery/scenario generation limits
# Max same-origin pages explored (1-10)
DISCOVERY_PAGE_LIMIT=4
# Max scenarios per run (1-50)
MAX_SCENARIOS=12

# ------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Path to the SQLite database file (created automatically on first run)
DATABASE_PATH=./qa_copilot.db

# ------------------------------------------------------------------
# Screenshots
# ------------------------------------------------------------------
# Directory where screenshots are stored
SCREENSHOTS_DIR=./screenshots

# ------------------------------------------------------------------
# Browser
# ------------------------------------------------------------------
# Set to "false" (also "0", "no", "off") to run Playwright in headed mode (useful
# for debugging). Any other value, or leaving it unset, runs headless.
HEADLESS=true

# Viewport dimensions
BROWSER_WIDTH=1280
BROWSER_HEIGHT=800

# Per-action timeout in milliseconds for scenario steps (page discovery uses a fixed 15s).
# It is also the ceiling for wait steps: a longer requested wait is capped at this value.
STEP_TIMEOUT_MS=10000
